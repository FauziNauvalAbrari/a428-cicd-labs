pipeline {
  agent {
    docker {
      image 'node:18-alpine'
      args '-u root'
    }
  }

  environment {
    NODE_OPTIONS = '--openssl-legacy-provider'
  }

  stages {
    stage('Install Dependencies') {
      steps {
        sh 'npm install'
      }
    }

    stage('Build') {
      steps {
        sh 'npm run build'
      }
    }
  }
}

